{
  "name": "@crewly/ui",
  "version": "0.1.0",
  "description": "Crewly's shared UI components and design tokens. Imported by the OSS frontend and the Cloud portal so both look like one product.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./theme.css",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "theme.css",
    "tailwind-preset.cjs"
  ],
  "scripts": {
    "build": "tsup && tailwindcss -c tailwind.config.cjs -i src/styles.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "lucide-react": ">=0.263.1",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.0.3",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.0.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "tailwind-merge": "^2.6.0"
  }
}
