{
  "name": "crewly-eval",
  "version": "0.1.0",
  "description": "Crewly Agent Evaluation Runner — real execution benchmarks",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "eval": "node dist/cli.js run --all",
    "eval:task": "node dist/cli.js run --task",
    "test": "vitest run src",
    "test:watch": "vitest src"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^10.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
