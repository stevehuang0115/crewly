{
  "id": "research-analysis",
  "name": "Research & Analysis Team",
  "description": "Research lead + analysts for competitive analysis and strategy",
  "category": "research",
  "version": "2.0.0",
  "tags": ["research", "analysis", "strategy", "competitive"],
  "icon": "microscope",
  "hierarchical": true,
  "compatibleRuntimes": ["claude-code", "crewly-agent"],
  "defaultRuntime": "crewly-agent",
  "norms": {
    "enabled": true,
    "files": [
      { "file": "research-methodology.md", "trigger": "always", "roles": ["*"] },
      { "file": "source-citation.md", "trigger": "always", "roles": ["*"] }
    ]
  },
  "roles": [
    {
      "role": "team-leader",
      "label": "Research Lead",
      "defaultName": "Research Lead",
      "count": 1,
      "hierarchyLevel": 1,
      "canDelegate": true,
      "defaultTools": [
        "delegate_task",
        "send_message",
        "get_team_status",
        "get_agent_status",
        "report_status",
        "complete_task",
        "handle_agent_failure",
        "schedule_check",
        "subscribe_event",
        "recall_memory",
        "remember",
        "read_file",
        "write_file",
        "edit_file",
        "glob",
        "grep",
        "bash_exec"
      ],
      "modelConfig": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.4
      },
      "enableBrowser": true
    },
    {
      "role": "analyst",
      "label": "Research Analyst",
      "defaultName": "Analyst",
      "count": 2,
      "hierarchyLevel": 2,
      "canDelegate": false,
      "reportsTo": "team-leader",
      "defaultTools": [
        "report_status",
        "complete_task",
        "send_message",
        "recall_memory",
        "remember",
        "read_file",
        "write_file",
        "edit_file",
        "glob",
        "grep",
        "bash_exec"
      ],
      "modelConfig": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.4
      },
      "enableBrowser": true
    }
  ],
  "verificationPipeline": {
    "name": "Research Quality Pipeline",
    "steps": [
      {
        "id": "source-verify",
        "name": "Source Verification",
        "description": "Verify all cited sources exist and are credible",
        "method": "source_verify",
        "critical": true,
        "config": {
          "minSources": 3,
          "requirePrimarySources": true
        }
      },
      {
        "id": "fact-check",
        "name": "Cross-Reference Check",
        "description": "Cross-check key claims against multiple independent sources",
        "method": "fact_check",
        "critical": true,
        "config": {
          "minCrossReferences": 2,
          "flagContradictions": true
        }
      },
      {
        "id": "data-validate",
        "name": "Data Validation",
        "description": "Check numerical data, dates, and statistics for consistency",
        "method": "data_validate",
        "critical": false,
        "config": {
          "checkDates": true,
          "checkNumbers": true,
          "checkPercentages": true
        }
      }
    ],
    "passPolicy": "critical_only",
    "maxRetries": 1
  },
  "maxWorkersPerLeader": 3,
  "mission": "Conduct rigorous competitive analysis and strategic research with verified sources",
  "budget": {
    "maxTokensPerDay": 3000000,
    "alertThreshold": 80
  },
  "qualityGate": {
    "autoApprove": false,
    "minQualityScore": 85
  }
}
