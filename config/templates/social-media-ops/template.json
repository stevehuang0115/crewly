{
  "id": "social-media-ops",
  "name": "Social Media Operations Team",
  "description": "Content creation, visual review, and multi-platform publishing",
  "category": "content",
  "version": "2.0.0",
  "tags": ["content", "social-media", "visual", "marketing"],
  "icon": "smartphone",
  "hierarchical": true,
  "compatibleRuntimes": ["claude-code", "crewly-agent"],
  "defaultRuntime": "crewly-agent",
  "norms": {
    "enabled": true,
    "files": [
      { "file": "posting-schedule.md", "trigger": "always", "roles": ["*"] },
      { "file": "engagement-rules.md", "trigger": "always", "roles": ["*"] }
    ]
  },
  "roles": [
    {
      "role": "team-leader",
      "label": "Content Director",
      "defaultName": "Content Director",
      "count": 1,
      "hierarchyLevel": 1,
      "canDelegate": true,
      "defaultTools": [
        "delegate_task",
        "send_message",
        "get_team_status",
        "get_agent_status",
        "report_status",
        "complete_task",
        "handle_agent_failure",
        "schedule_check",
        "subscribe_event",
        "recall_memory",
        "remember",
        "read_file",
        "write_file",
        "edit_file",
        "glob",
        "bash_exec"
      ],
      "modelConfig": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.5
      },
      "enableBrowser": true
    },
    {
      "role": "creator",
      "label": "Content Creator",
      "defaultName": "Creator",
      "count": 2,
      "hierarchyLevel": 2,
      "canDelegate": false,
      "reportsTo": "team-leader",
      "defaultTools": [
        "report_status",
        "complete_task",
        "send_message",
        "recall_memory",
        "remember",
        "read_file",
        "write_file",
        "edit_file",
        "glob",
        "bash_exec"
      ],
      "modelConfig": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.6
      },
      "enableBrowser": true
    }
  ],
  "verificationPipeline": {
    "name": "Content Quality Pipeline",
    "steps": [
      {
        "id": "screenshot-review",
        "name": "Visual Screenshot Review",
        "description": "Take screenshot of content and review visually",
        "method": "screenshot_review",
        "critical": true,
        "config": {
          "captureMethod": "computer-use",
          "checkBranding": true
        }
      },
      {
        "id": "gemini-vision",
        "name": "AI Visual Analysis",
        "description": "Use Gemini Vision to analyze visual quality and brand consistency",
        "method": "gemini_vision",
        "critical": true,
        "config": {
          "model": "gemini-2.0-flash",
          "checkCriteria": ["brand_consistency", "visual_quality", "text_readability"]
        }
      },
      {
        "id": "content-check",
        "name": "Content Guidelines Check",
        "description": "Verify content follows style guide and tone",
        "method": "content_check",
        "critical": false,
        "config": {
          "styleGuide": ".crewly/docs/style-guide.md"
        }
      }
    ],
    "passPolicy": "critical_only",
    "maxRetries": 2
  },
  "maxWorkersPerLeader": 3,
  "mission": "Create engaging social media content with consistent branding across platforms",
  "budget": {
    "maxTokensPerDay": 2000000,
    "alertThreshold": 80
  },
  "qualityGate": {
    "autoApprove": true,
    "minQualityScore": 70
  }
}
