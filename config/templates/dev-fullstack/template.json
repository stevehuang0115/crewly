{
  "id": "dev-fullstack",
  "name": "Fullstack Development Team",
  "description": "Team Leader + developers + QA for building web applications",
  "category": "development",
  "version": "2.0.0",
  "tags": ["development", "web", "fullstack", "testing"],
  "icon": "laptop",
  "hierarchical": true,
  "compatibleRuntimes": ["claude-code", "crewly-agent"],
  "defaultRuntime": "crewly-agent",
  "norms": {
    "enabled": true,
    "files": [
      { "file": "code-commit-sop.md", "trigger": "before_commit", "roles": ["developer", "team-leader"] },
      { "file": "quality-gates.md", "trigger": "before_deploy", "roles": ["*"] }
    ]
  },
  "roles": [
    {
      "role": "team-leader",
      "label": "Tech Lead",
      "defaultName": "Tech Lead",
      "count": 1,
      "hierarchyLevel": 1,
      "canDelegate": true,
      "defaultTools": [
        "delegate_task",
        "send_message",
        "get_team_status",
        "get_agent_status",
        "report_status",
        "complete_task",
        "handle_agent_failure",
        "schedule_check",
        "subscribe_event",
        "recall_memory",
        "remember",
        "bash_exec",
        "read_file",
        "write_file",
        "edit_file",
        "glob",
        "grep",
        "git_status",
        "git_diff",
        "git_commit"
      ],
      "modelConfig": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.3
      },
      "enableBrowser": true
    },
    {
      "role": "developer",
      "label": "Developer",
      "defaultName": "Developer",
      "count": 2,
      "hierarchyLevel": 2,
      "canDelegate": false,
      "reportsTo": "team-leader",
      "defaultTools": [
        "report_status",
        "complete_task",
        "send_message",
        "recall_memory",
        "remember",
        "bash_exec",
        "read_file",
        "write_file",
        "edit_file",
        "glob",
        "grep",
        "git_status",
        "git_diff",
        "git_commit"
      ],
      "modelConfig": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.2
      },
      "enableBrowser": false
    },
    {
      "role": "qa-engineer",
      "label": "QA Engineer",
      "defaultName": "QA",
      "count": 1,
      "hierarchyLevel": 2,
      "canDelegate": false,
      "reportsTo": "team-leader",
      "defaultTools": [
        "report_status",
        "complete_task",
        "send_message",
        "recall_memory",
        "remember",
        "bash_exec",
        "read_file",
        "glob",
        "grep"
      ],
      "modelConfig": {
        "provider": "anthropic",
        "model": "claude-sonnet-4-20250514",
        "temperature": 0.2
      },
      "enableBrowser": true
    }
  ],
  "verificationPipeline": {
    "name": "Development Quality Pipeline",
    "steps": [
      {
        "id": "quality-gates",
        "name": "Quality Gates",
        "description": "Run typecheck, unit tests, lint, and build",
        "method": "quality_gates",
        "critical": true,
        "config": {
          "gates": ["typecheck", "tests", "build"]
        }
      },
      {
        "id": "code-review",
        "name": "Code Review",
        "description": "TL reviews code diff for patterns and quality",
        "method": "code_review",
        "critical": true,
        "config": {
          "maxDiffLines": 500,
          "checkPatterns": true
        }
      },
      {
        "id": "browser-test",
        "name": "Browser Verification",
        "description": "Open in browser, screenshot, verify UI matches spec",
        "method": "browser_test",
        "critical": false,
        "config": {
          "screenshotTool": "computer-use",
          "viewports": ["desktop"]
        }
      },
      {
        "id": "e2e",
        "name": "E2E Tests",
        "description": "Run Playwright end-to-end test suite",
        "method": "e2e_test",
        "critical": false,
        "config": {
          "framework": "playwright",
          "testDir": "tests/e2e"
        }
      }
    ],
    "passPolicy": "critical_only",
    "maxRetries": 2
  },
  "monitoringDefaults": {
    "idleEvent": true,
    "fallbackCheckMinutes": 5
  },
  "maxWorkersPerLeader": 4,
  "mission": "Build and maintain fullstack web applications with high code quality and test coverage",
  "budget": {
    "maxTokensPerDay": 5000000,
    "alertThreshold": 80
  },
  "qualityGate": {
    "autoApprove": false,
    "minQualityScore": 80
  }
}
